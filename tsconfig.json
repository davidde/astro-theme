{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "types": ["@types/bun"],
    "paths": {
      "@theme/*": ["./src/overrides/*", "./src/*"],
      "@theme-original/*": ["./src/*"]
    }
  }
}
